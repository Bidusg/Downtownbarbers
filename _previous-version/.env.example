# ============================================================
# Downtown Barbers — miljøvariabler
# Kopier til .env.local (lokalt) og legg inn i Vercel (produksjon).
# Tomme verdier => mock-modus for den integrasjonen. Trygt å deploye.
# ============================================================

# --- Base ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (e-post) ---
RESEND_API_KEY=
# La stå tom til downtownbarbers.no er verifisert i Resend.
# Tom => fallback "Downtown Barbers <onboarding@resend.dev>"
EMAIL_FROM=

# --- Shopify Storefront API (nettbutikk) ---
# Fra Shopify admin: Settings -> Apps -> Develop apps -> Storefront API
# Begge tomme => /shop viser mock-produkter med Demo-badge.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_TOKEN=

# --- Vipps ePayment ---
# Fra portal.vippsmobilepay.no etter bedriftsavtale.
# Alle tomme => mock-modus (simulert betaling, samme flyt).
VIPPS_ENV=test
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=
