# =====================================================================
# Downtown Barbers – miljøvariabler (kopier til .env.local og fyll inn)
# =====================================================================

# Supabase (Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=https://kekdspamodouqqeptxwa.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=       # "anon / publishable key" fra API Keys-siden
SUPABASE_SERVICE_ROLE_KEY=            # kun server-side, ALDRI eksponer i klient

# Stripe (fra dashboard.stripe.com -> Developers -> API keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Vipps (fra portal.vippsmobilepay.com – kommer når bedriftsavtale er klar)
VIPPS_CLIENT_ID=
VIPPS_CLIENT_SECRET=
VIPPS_SUBSCRIPTION_KEY=
VIPPS_MSN=                           # Merchant Serial Number

# E-post (Resend) – for bookingbekreftelse + påminnelse på e-post
RESEND_API_KEY=
EMAIL_FROM=                           # f.eks. "Downtown Barbers <post@dittdomene.no>" (verifisert domene). Tomt = Resend testavsender

# SMS (Twilio) – for timepåminnelse på SMS. Tomt = SMS hoppes over (e-post virker likevel)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=                          # avsendernummer i E.164 (+47…) eller godkjent alfanumerisk avsender

# Cron – beskytter /api/cron/reminders. Vercel Cron sender denne automatisk.
CRON_SECRET=

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000
